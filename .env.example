# ==============================================================================
# Sectors Hackathon 2026 — Market Intelligence Agent Environment Variables
# ==============================================================================

# Sectors API Configuration
# Dapatkan API Key Anda dari: https://sectors.app (Settings -> API Key Management)
SECTORS_API_KEY=your_sectors_api_key_here
SECTORS_BASE_URL=https://api.sectors.app/v2/

# Snapshot Cache Configuration (Demo Reliability Mechanism §6.10)
SECTORS_CACHE_ENABLED=true
SECTORS_CACHE_DIR=data/cache/sectors
SECTORS_CACHE_TTL_HOURS=24
SECTORS_OFFLINE_FALLBACK=true

# Politeness / Rate Limiting (seconds delay between requests)
SECTORS_RATE_LIMIT_DELAY=0.2

# LLM Configuration (Untuk Hari 4 Smart Research & Mosaic Synthesis)
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-2.5-flash

# Logging
LOG_LEVEL=INFO
